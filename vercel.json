{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/site/styles.css"
    },
    {
      "source": "/release-notes",
      "destination": "/site/release-notes.md"
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/Reece-Challinor/devnoise/releases/latest/download/DevNoise.dmg",
      "permanent": true
    }
  ]
}
